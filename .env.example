# ─────────────────────────────────────────────────────────────────────────────
# Agentic DEX - environment template
# Copy to .env  (cp .env.example .env) and fill in what you need.
# Scripts/deploy.js, deploy_tokens.js and seed-liquidity.js rewrite the
# address/token values for you after each deployment.
# ─────────────────────────────────────────────────────────────────────────────

# --- Chain ---------------------------------------------------------------
RPC_URL=http://127.0.0.1:7545
CHAIN_ID=1337
# Must be an account that exists in Ganache (the agent signs transactions with it).
# Ganache > Accounts > key icon gives you the private keys.
PRIVATE_KEY=0xbc9cb91597c456ba71ac42f366417893e4f55d6c2631b479c446314befc854b4

# Optional: extra addresses (comma separated) that npm run seed should fund with
# test tokens - e.g. the MetaMask account you trade from.
SEED_ACCOUNTS=

# --- Deployed addresses (written by Scripts/deploy.js) -------------------
Factory_Address=
Router_Address=

# --- Deployed test tokens (written by Scripts/deploy_tokens.js) ----------
USDC_Address=
DAI_Address=
WBTC_Address=
WETH_Address=
LINK_Address=
UNI_Address=

# --- MySQL (indexer, PHP API, agents) ------------------------------------
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=AI_Autonomus_dex

# --- AI / MCP ------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AGENT_INTERVAL_SECONDS=60

# --- Frontend (VITE_ prefixed vars are exposed to the browser) -----------
# Where Scripts/api_agent.php is served from
VITE_API_BASE_URL=http://127.0.0.1:8000/Scripts/api_agent.php
